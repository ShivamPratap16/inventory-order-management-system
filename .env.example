# Copy this file to ".env" and adjust values. docker-compose reads it automatically.
# NEVER commit the real .env - it is git-ignored.

# --- PostgreSQL ---
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=supersecret_change_me
POSTGRES_DB=inventory_db

# --- Backend ---
BACKEND_PORT=8000
# Frontend origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOW_STOCK_THRESHOLD=10

# --- Frontend ---
FRONTEND_PORT=3000
# Where the browser reaches the backend. Matches BACKEND_PORT above.
VITE_API_BASE_URL=http://localhost:8000
